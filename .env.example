# COLMAP Automatizer - Environment Configuration
# Copy this file to .env.local or .env.remote and adjust values for your environment.

# Execution mode: "docker" (university server) or "local" (local dev machine)
COLMAP_MODE=local

# Docker image for COLMAP (used when COLMAP_MODE=docker)
DOCKER_IMAGE=colmap/colmap:latest

# Path to COLMAP binary (used when COLMAP_MODE=local)
COLMAP_BIN=/usr/local/bin/colmap

# Scratch directory - MUST be outside /home on the university server
# Examples: /scratch/$USER/colmap_auto  (remote)  or  ./scratch  (local)
SCRATCH_DIR=

# Enable GPU acceleration (true/false). Set false for CPU-only local testing.
USE_GPU=true

# Local development safety switch.
# If true, allows scratch_dir inside /home (for Mac/PC dev).
# If false, aborts if scratch_dir resolves inside /home or SCRATCH_DIR is missing.
LOCAL_DEV=true